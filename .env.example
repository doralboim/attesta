# Core
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://attesta:attesta@localhost:5432/attesta
PUBLIC_BASE_URL=http://localhost:8000
ISSUER_URL=https://api.attesta.dev

# Snapshots (local dev — switch to r2 in production)
SNAPSHOT_STORE_BACKEND=local
LOCAL_SNAPSHOT_DIR=.snapshots

# Optional live ingestion (Apify actors — not required; see docs/decisions/008-fixture-first-ingestion.md)
APIFY_TOKEN=
APIFY_IDEALISTA_ACTOR_ID=
APIFY_IMOVIRTUAL_ACTOR_ID=

# LLM — provider-agnostic via LiteLLM (any supported provider; set ONE key for your chosen provider)
# Docs: https://docs.litellm.ai/docs/providers
LLM_ENABLED=false
# Examples (pick one provider or mix parse/adjudicate across providers):
# LLM_PARSE_MODEL=anthropic/claude-haiku-4-5
# LLM_ADJUDICATE_MODEL=anthropic/claude-haiku-4-5
# LLM_PARSE_MODEL=openai/gpt-4o-mini
# LLM_ADJUDICATE_MODEL=openai/gpt-4o-mini
# LLM_PARSE_MODEL=gemini/gemini-2.0-flash
# LLM_ADJUDICATE_MODEL=gemini/gemini-2.0-flash
# LLM_PARSE_MODEL=azure/gpt-4o-mini
# LLM_ADJUDICATE_MODEL=azure/gpt-4o-mini
LLM_PARSE_MODEL=
LLM_ADJUDICATE_MODEL=
LLM_EMBEDDING_MODEL=
# Provider API keys — set only the key(s) for your chosen provider(s):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# AZURE_API_KEY=  (+ AZURE_API_BASE, AZURE_API_VERSION)
# COHERE_API_KEY=
# MISTRAL_API_KEY=
# GROQ_API_KEY=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS_PARSE=1024
LLM_MAX_TOKENS_ADJUDICATE=2048
LLM_PARSE_SYSTEM_PROMPT_PATH=config/prompts/parse_system.txt
LLM_PARSE_USER_PROMPT_PATH=config/prompts/parse_user.txt
LLM_ADJUDICATE_SYSTEM_PROMPT_PATH=config/prompts/adjudicate_system.txt
LLM_ADJUDICATE_USER_PROMPT_PATH=config/prompts/adjudicate_user.txt

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_FLUSH_INTERVAL_SECONDS=60

# x402 (optional — set X402_ENABLED=true + wallet for live rail)
X402_ENABLED=false
X402_EVM_ADDRESS=
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_NETWORK=eip155:84532

# Ingestion
DELIST_MISS_THRESHOLD=2

# JWS (auto-generated in keys/ if empty)
JWS_PRIVATE_KEY_PEM=
JWS_KID=attesta-v1

# Dev API key
BOOTSTRAP_API_KEY=dev-key-change-me
